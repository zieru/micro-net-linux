#!/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

detect_iface() {
    if [ -f /etc/network.conf ]; then
        # shellcheck disable=SC1091
        . /etc/network.conf
        if [ -n "${IFACE:-}" ] && [ -d "/sys/class/net/$IFACE" ]; then
            echo "$IFACE"
            return
        fi
    fi
    if [ -d /sys/class/net/eth0 ]; then
        echo "eth0"
        return
    fi
    for dev in /sys/class/net/*; do
        name="$(basename "$dev")"
        case "$name" in
            lo|wg*|tun*|tap*|sit*|ip6tnl*) continue ;;
            *) echo "$name"; return ;;
        esac
    done
}

start() {
    echo "[net] Configuring loopback and network interface..."
    ip link set lo up
    ip addr add 127.0.0.1/8 dev lo 2>/dev/null || true

    MODE="dhcp"
    MODE6="slaac"
    if [ -f /etc/network.conf ]; then
        # shellcheck disable=SC1091
        . /etc/network.conf
    fi

    IFACE="$(detect_iface)"
    if [ -z "$IFACE" ]; then
        echo "[net] WARNING: No Ethernet interface found."
        return 0
    fi

    ip link set "$IFACE" up

    # --- IPv4 Configuration ---
    case "${MODE:-dhcp}" in
        static)
            if [ -n "${STATIC_IP:-}" ]; then
                echo "[net] Applying static IPv4 ($STATIC_IP) on $IFACE..."
                ip -4 addr flush dev "$IFACE" 2>/dev/null || true
                ip -4 addr add "$STATIC_IP" dev "$IFACE"
                if [ -n "${GATEWAY:-}" ]; then
                    ip -4 route replace default via "$GATEWAY" dev "$IFACE"
                fi
            fi
            ;;
        off|none)
            echo "[net] IPv4 disabled on $IFACE."
            ip -4 addr flush dev "$IFACE" 2>/dev/null || true
            ;;
        *)
            echo "[net] Starting IPv4 DHCP (udhcpc) on $IFACE..."
            udhcpc -i "$IFACE" -b -p /run/udhcpc.pid -s /usr/share/udhcpc/default.script >/dev/null 2>&1 || true
            i=0
            while [ "$i" -lt 6 ]; do
                if ip -4 addr show dev "$IFACE" | grep -q "inet "; then
                    break
                fi
                sleep 1
                i=$((i + 1))
            done
            ;;
    esac

    # --- IPv6 Dual-Stack Configuration ---
    case "${MODE6:-slaac}" in
        static)
            if [ -n "${STATIC_IP6:-}" ]; then
                echo "[net] Applying static IPv6 ($STATIC_IP6) on $IFACE..."
                sysctl -w "net.ipv6.conf.$IFACE.disable_ipv6=0" >/dev/null 2>&1 || true
                ip -6 addr flush dev "$IFACE" scope global 2>/dev/null || true
                ip -6 addr add "$STATIC_IP6" dev "$IFACE" 2>/dev/null || true
                if [ -n "${GATEWAY6:-}" ]; then
                    ip -6 route replace default via "$GATEWAY6" dev "$IFACE" 2>/dev/null || true
                fi
            fi
            ;;
        off|none)
            echo "[net] IPv6 disabled on $IFACE."
            sysctl -w "net.ipv6.conf.$IFACE.disable_ipv6=1" >/dev/null 2>&1 || true
            ;;
        *)
            sysctl -w "net.ipv6.conf.$IFACE.disable_ipv6=0" >/dev/null 2>&1 || true
            sysctl -w "net.ipv6.conf.$IFACE.accept_ra=1" >/dev/null 2>&1 || true
            ;;
    esac

    # --- DNS ---
    if [ -n "${DNS:-}" ] && [ "${MODE:-dhcp}" != "dhcp" ]; then
        : > /etc/resolv.conf
        for ns in $DNS; do
            echo "nameserver $ns" >> /etc/resolv.conf
        done
    fi
}

stop() {
    if [ -f /run/udhcpc.pid ]; then
        kill "$(cat /run/udhcpc.pid)" 2>/dev/null || true
        rm -f /run/udhcpc.pid
    fi
}

case "${1:-start}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
