#!/bin/sh
# BusyBox /etc/init.d/S50x-ui-agent for zieru/micro-net-linux
# POSIX sh only (no bash, no OpenRC/systemd).

NAME="x-ui-agent-rs"
DAEMON="/usr/local/bin/x-ui-agent-rs"
PIDFILE="/run/x-ui-agent.pid"
LOGFILE="/var/log/x-ui-agent.log"
CONF_FILE="/etc/x-ui-agent/agent.conf"

LISTEN=":2053"
STATE_DIR="/etc/x-ui-agent"
BASE_PATH="/"
TLS_CERT="/etc/x-ui-agent/cert.pem"
TLS_KEY="/etc/x-ui-agent/key.pem"
SHELL_ALLOW_IP=""

[ -f "$CONF_FILE" ] && . "$CONF_FILE"
[ -x "$DAEMON" ] || exit 0

start() {
    printf "[agent] Starting %s... " "$NAME"
    mkdir -p "$STATE_DIR"
    chmod 0700 "$STATE_DIR"

    EXTRA_ARGS=""
    [ -n "$BASE_PATH" ] && EXTRA_ARGS="$EXTRA_ARGS -base-path $BASE_PATH"
    [ -n "$TLS_CERT" ] && EXTRA_ARGS="$EXTRA_ARGS -tls-cert $TLS_CERT"
    [ -n "$TLS_KEY" ] && EXTRA_ARGS="$EXTRA_ARGS -tls-key $TLS_KEY"
    [ -n "$SHELL_ALLOW_IP" ] && EXTRA_ARGS="$EXTRA_ARGS -shell-allow-ip $SHELL_ALLOW_IP"

    start-stop-daemon -S -b -m -p "$PIDFILE" \
        -x "$DAEMON" -- \
        -listen "$LISTEN" \
        -state-dir "$STATE_DIR" \
        $EXTRA_ARGS >> "$LOGFILE" 2>&1
    echo "OK"
}

stop() {
    printf "[agent] Stopping %s... " "$NAME"
    if [ -f "$PIDFILE" ]; then
        start-stop-daemon -K -p "$PIDFILE" -s TERM
        rm -f "$PIDFILE"
    else
        killall "$NAME" 2>/dev/null || true
    fi
    echo "OK"
}

case "${1:-start}" in
    start) start ;;
    stop) stop ;;
    restart|reload) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
