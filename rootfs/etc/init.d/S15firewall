#!/bin/sh
# BusyBox /etc/init.d/S15firewall for zieru/micro-net-linux
# Kernel-level nftables auto-ban & allowlist (0 background daemon RAM).

NFT="/usr/sbin/nft"
CONF="/etc/firewall.conf"

ENABLE_FIREWALL="1"
TRUSTED_IPS=""
ADMIN_PORTS=""
RATELIMIT_PER_MIN="5"
BAN_MINUTES="10"

[ -f "$CONF" ] && . "$CONF"
[ -x "$NFT" ] || exit 0

collect_admin_ports() {
    # Auto-detect TinySSH port
    TINYSSH_PORT="22"
    [ -f /etc/tinyssh/tinyssh.conf ] && . /etc/tinyssh/tinyssh.conf
    # Auto-detect x-ui-agent-rs port from LISTEN (e.g. ":2053" or "[::]:8443")
    LISTEN=":2053"
    [ -f /etc/x-ui-agent/agent.conf ] && . /etc/x-ui-agent/agent.conf
    AGENT_PORT="${LISTEN##*:}"

    RAW_PORTS="${TINYSSH_PORT:-22} ${AGENT_PORT:-2053} ${ADMIN_PORTS:-}"
    printf "%s\n" $RAW_PORTS | awk '/^[0-9]+$/ && !seen[$0]++ { if (out != "") out = out ", "; out = out $0 } END { print out }'
}

start() {
    if [ "${ENABLE_FIREWALL:-1}" != "1" ]; then
        echo "[fw] Firewall disabled in $CONF."
        return 0
    fi

    PORTS_CSV="$(collect_admin_ports)"
    [ -n "$PORTS_CSV" ] || PORTS_CSV="22, 2053"

    echo "[fw] Applying kernel nftables rules (admin ports: $PORTS_CSV)..."
    "$NFT" delete table inet minilinux_fw 2>/dev/null || true

    RULESET="
table inet minilinux_fw {
    set banned_v4 {
        type ipv4_addr
        flags dynamic,timeout
        timeout ${BAN_MINUTES}m
    }
    set banned_v6 {
        type ipv6_addr
        flags dynamic,timeout
        timeout ${BAN_MINUTES}m
    }
    chain input {
        type filter hook input priority 0; policy accept;
        iif lo accept
        ct state established,related accept
        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept
"

    if [ -n "${TRUSTED_IPS:-}" ]; then
        for tip in $TRUSTED_IPS; do
            case "$tip" in
                *:*) RULESET="${RULESET}        ip6 saddr $tip tcp dport { $PORTS_CSV } accept\n" ;;
                *)   RULESET="${RULESET}        ip saddr $tip tcp dport { $PORTS_CSV } accept\n" ;;
            esac
        done
        RULESET="${RULESET}        tcp dport { $PORTS_CSV } drop\n"
    else
        RULESET="${RULESET}        ip saddr @banned_v4 tcp dport { $PORTS_CSV } drop\n"
        RULESET="${RULESET}        ip6 saddr @banned_v6 tcp dport { $PORTS_CSV } drop\n"
        RULESET="${RULESET}        tcp dport { $PORTS_CSV } ct state new meter flood_v4 { ip saddr limit rate over ${RATELIMIT_PER_MIN}/minute } add @banned_v4 { ip saddr } drop\n"
        RULESET="${RULESET}        tcp dport { $PORTS_CSV } ct state new meter flood_v6 { ip6 saddr limit rate over ${RATELIMIT_PER_MIN}/minute } add @banned_v6 { ip6 saddr } drop\n"
    fi

    RULESET="${RULESET}    }\n}\n"
    printf "%b" "$RULESET" | "$NFT" -f -
}

stop() {
    echo "[fw] Flushing kernel nftables table..."
    "$NFT" delete table inet minilinux_fw 2>/dev/null || true
}

status() {
    "$NFT" list table inet minilinux_fw 2>/dev/null || echo "Firewall inactive."
}

case "${1:-start}" in
    start) start ;;
    stop) stop ;;
    restart|reload) stop; start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
