#!/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

NTP_PEERS="-p time.cloudflare.com -p pool.ntp.org"

start() {
    if pidof ntpd >/dev/null 2>&1; then
        return 0
    fi
    echo "[ntp] Starting ntpd time sync (VLESS REALITY clock sync)..."
    # BusyBox ntpd forks to background automatically without -n
    # shellcheck disable=SC2086
    ntpd $NTP_PEERS >/dev/null 2>&1 || true
}

stop() {
    killall ntpd 2>/dev/null || true
}

case "${1:-start}" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
