#!/bin/sh
# BusyBox udhcpc hook script (POSIX sh)

[ -z "$1" ] && exit 1

RESOLV_CONF="/etc/resolv.conf"

case "$1" in
    deconfig)
        ip addr flush dev "$interface" 2>/dev/null || true
        ip link set "$interface" up
        ;;

    renew|bound)
        PREFIX="${mask:-24}"
        ip addr flush dev "$interface" 2>/dev/null || true
        ip addr add "${ip}/${PREFIX}" dev "$interface"

        if [ -n "${router:-}" ]; then
            for r in $router; do
                ip route replace default via "$r" dev "$interface"
                break
            done
        fi

        if [ -n "${dns:-}" ]; then
            : > "$RESOLV_CONF"
            [ -n "${domain:-}" ] && echo "search $domain" >> "$RESOLV_CONF"
            for ns in $dns; do
                echo "nameserver $ns" >> "$RESOLV_CONF"
            done
        fi
        ;;
esac

exit 0
