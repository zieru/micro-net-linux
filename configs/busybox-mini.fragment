# ==============================================================================
# BusyBox 1.36.1 Minimal Static Fragment (musl-libc)
# Applied over `make defconfig`
# ==============================================================================

CONFIG_STATIC=y
CONFIG_TC=n
CONFIG_FEATURE_MOUNT_NFS=n
CONFIG_FEATURE_INETD_RPC=n
CONFIG_FEATURE_UTMP=n
CONFIG_FEATURE_WTMP=n
CONFIG_PAM=n
CONFIG_SELINUX=n
CONFIG_SHA1_HWACCEL=n
CONFIG_SHA256_HWACCEL=n

CONFIG_FEATURE_IPV6=y
CONFIG_NTPD=y
CONFIG_UDHCPC=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_FEATURE_IP_RULE=y
CONFIG_FEATURE_IP_TUNNEL=y

CONFIG_FDISK=y
CONFIG_BLOCKDEV=y
CONFIG_MKE2FS=y
CONFIG_BLKID=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_OPENSSL=n
CONFIG_FEATURE_WGET_LONG_OPTIONS=y
CONFIG_FEATURE_EDITING_VI=n

CONFIG_PASSWD=y
CONFIG_FEATURE_SHADOWPASSWDS=y
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y
