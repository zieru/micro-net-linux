# Enforce LF line endings for all Linux configs, scripts, and rootfs files
* text=auto eol=lf

*.sh text eol=lf
*.config text eol=lf
*.fragment text eol=lf
*.conf text eol=lf
*.h text eol=lf
*.yml text eol=lf
*.md text eol=lf
rootfs/** text eol=lf

# Windows PowerShell scripts keep CRLF
*.ps1 text eol=crlf

# Binary artifacts
*.img binary
*.img.gz binary
*.iso binary
*.vdi binary
*.gz binary
*.xz binary
*.bz2 binary
